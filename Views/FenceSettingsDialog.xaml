<Window x:Class="FencesWPF.Views.FenceSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configuración del Fence"
        Width="320" Height="520"
        WindowStyle="ToolWindow"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#FF1A1A2E"
        Foreground="White">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ══ Appearance ══ -->
        <GroupBox Header="Apariencia" Grid.Row="0" Margin="0,0,0,10"
                  Foreground="White" BorderBrush="#FF4A90D9">
            <StackPanel Margin="6,6,6,4">

                <TextBlock Text="Opacidad:" Foreground="#FFB0B0C0" FontSize="11"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="38"/>
                    </Grid.ColumnDefinitions>
                    <Slider x:Name="SliderOpacity" Grid.Column="0"
                            Minimum="0.1" Maximum="1" Value="0.92"
                            TickFrequency="0.05" IsSnapToTickEnabled="True"
                            ValueChanged="SliderOpacity_ValueChanged"/>
                    <TextBlock x:Name="TbOpacity" Grid.Column="1"
                               Text="92%" Foreground="#FFB0B0C0"
                               VerticalAlignment="Center" FontSize="10" Margin="4,0,0,0"/>
                </Grid>

                <TextBlock Text="Color de Fondo (hex AARRGGBB):" Foreground="#FFB0B0C0"
                           FontSize="11" Margin="0,8,0,2"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="30"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TbBgColor" Grid.Column="0" Text="#CC1E1E2E"
                             TextChanged="TbBgColor_TextChanged"/>
                    <Border x:Name="BgPreview" Grid.Column="1" Margin="4,2,0,2"
                            CornerRadius="4" Background="#CC1E1E2E"/>
                </Grid>

                <TextBlock Text="Color del Borde (hex):" Foreground="#FFB0B0C0"
                           FontSize="11" Margin="0,6,0,2"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="30"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TbBorderColor" Grid.Column="0" Text="#FF4A90D9"
                             TextChanged="TbBorderColor_TextChanged"/>
                    <Border x:Name="BorderPreview" Grid.Column="1" Margin="4,2,0,2"
                            CornerRadius="4" Background="#FF4A90D9"/>
                </Grid>

                <TextBlock Text="Color de Barra de Título (hex):" Foreground="#FFB0B0C0"
                           FontSize="11" Margin="0,6,0,2"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="30"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TbTitleColor" Grid.Column="0" Text="#FF2A2A4A"
                             TextChanged="TbTitleColor_TextChanged"/>
                    <Border x:Name="TitlePreview" Grid.Column="1" Margin="4,2,0,2"
                            CornerRadius="4" Background="#FF2A2A4A"/>
                </Grid>
            </StackPanel>
        </GroupBox>

        <!-- ══ Behavior ══ -->
        <GroupBox Header="Comportamiento" Grid.Row="1" Margin="0,0,0,10"
                  Foreground="White" BorderBrush="#FF4A90D9">
            <StackPanel Margin="6,6,6,4">
                <RadioButton x:Name="RbStatic"    Content="Estático — siempre expandido"
                             Foreground="White" Margin="0,2" GroupName="Mode"
                             Checked="RbMode_Checked"/>
                <RadioButton x:Name="RbAutoRoll"  Content="Auto-Roll — expande al pasar el ratón"
                             Foreground="White" Margin="0,2" GroupName="Mode" IsChecked="True"
                             Checked="RbMode_Checked"/>
                <RadioButton x:Name="RbCollapsed" Content="Siempre colapsado"
                             Foreground="White" Margin="0,2" GroupName="Mode"
                             Checked="RbMode_Checked"/>
            </StackPanel>
        </GroupBox>

        <!-- ══ Icon Size ══ -->
        <GroupBox Header="Tamaño de Iconos" Grid.Row="2" Margin="0,0,0,10"
                  Foreground="White" BorderBrush="#FF4A90D9">
            <StackPanel Orientation="Horizontal" Margin="6,6,6,4">
                <RadioButton x:Name="RbSmall"  Content="Pequeño (32)"
                             Foreground="White" Margin="0,0,12,0" GroupName="IconSize"
                             Checked="RbIconSize_Checked"/>
                <RadioButton x:Name="RbMedium" Content="Mediano (48)"
                             Foreground="White" Margin="0,0,12,0" GroupName="IconSize" IsChecked="True"
                             Checked="RbIconSize_Checked"/>
                <RadioButton x:Name="RbLarge"  Content="Grande (64)"
                             Foreground="White" GroupName="IconSize"
                             Checked="RbIconSize_Checked"/>
            </StackPanel>
        </GroupBox>

        <!-- ══ Presets ══ -->
        <GroupBox Header="Temas Rápidos" Grid.Row="3" Margin="0,0,0,10"
                  Foreground="White" BorderBrush="#FF4A90D9">
            <WrapPanel Margin="6,4">
                <Button Content="🌑 Oscuro"   Width="70" Margin="3" Click="Theme_Dark"/>
                <Button Content="🌊 Azul"     Width="70" Margin="3" Click="Theme_Blue"/>
                <Button Content="🌿 Verde"    Width="70" Margin="3" Click="Theme_Green"/>
                <Button Content="🌹 Rojo"     Width="70" Margin="3" Click="Theme_Red"/>
                <Button Content="🍇 Morado"   Width="70" Margin="3" Click="Theme_Purple"/>
                <Button Content="🌙 Noche"    Width="70" Margin="3" Click="Theme_Night"/>
            </WrapPanel>
        </GroupBox>

        <!-- ══ Actions ══ -->
        <StackPanel Grid.Row="4" VerticalAlignment="Bottom">
            <Button Content="🗑  Eliminar este Fence"
                    Background="#FF6B1A1A" Foreground="White"
                    Margin="0,4" Padding="8,6"
                    Click="BtnDelete_Click"/>
            <Button Content="↩  Restablecer valores por defecto"
                    Margin="0,4" Padding="8,6"
                    Click="BtnReset_Click"/>
        </StackPanel>

        <!-- ══ Footer ══ -->
        <StackPanel Grid.Row="5" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Cerrar" Width="80" Click="BtnClose_Click"/>
        </StackPanel>
    </Grid>
</Window>
