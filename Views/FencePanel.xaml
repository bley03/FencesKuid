<Window x:Class="FencesWPF.Views.FencePanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fa="clr-namespace:FontAwesome.Sharp;assembly=FontAwesome.Sharp"
        Title="FencePanel"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="CanResize"
        MinWidth="160"
        MinHeight="60"
        MouseMove="Window_MouseMove"
        PreviewMouseLeftButtonDown="Window_PreviewMouseLeftButtonDown"
        Closing="Window_Closing"
        Loaded="Window_Loaded">

    <Window.Resources>

        <!-- ── Paleta ── -->
        <SolidColorBrush x:Key="AccentBrush"    Color="#A855F7"/>
        <SolidColorBrush x:Key="TextPrimary"    Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextSecondary"  Color="#99BBDD"/>
        <SolidColorBrush x:Key="GlassBorder"    Color="#33FFFFFF"/>
        <SolidColorBrush x:Key="BtnHover"       Color="#22FFFFFF"/>

        <!-- ── Botón título ── -->
        <Style x:Key="TitleBarButtonStyle" TargetType="Button">
            <Setter Property="Width"           Value="24"/>
            <Setter Property="Height"          Value="24"/>
            <Setter Property="Margin"          Value="1,0"/>
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Focusable"       Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7" BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background"
                                        Value="{StaticResource BtnHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Ítem de shortcut con hover animado ── -->
        <Style x:Key="ShortcutItemStyle" TargetType="Border">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderBrush"     Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="14"/>
            <Setter Property="Padding"         Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── ScrollBar invisible ── -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width"      Value="3"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid>
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#30FFFFFF"
                                                        CornerRadius="2" Margin="1,3"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- ══════════════════════════════════════════════
         PANEL PRINCIPAL
    ══════════════════════════════════════════════ -->
    <Border x:Name="MainBorder"
            Background="#D90F0F1E"
            BorderBrush="#33FFFFFF"
            BorderThickness="1"
            CornerRadius="20">

        <Border.Effect>
            <DropShadowEffect x:Name="PanelGlow"
                              Color="#A855F7"
                              BlurRadius="40"
                              ShadowDepth="0"
                              Opacity="0.3"/>
        </Border.Effect>

        <Grid>

            <!-- Highlight de borde superior (simula luz) -->
            <Border CornerRadius="20,20,0,0"
                    Height="1"
                    VerticalAlignment="Top"
                    Margin="20,1,20,0"
                    IsHitTestVisible="False">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#00FFFFFF" Offset="0"/>
                        <GradientStop Color="#60FFFFFF" Offset="0.5"/>
                        <GradientStop Color="#00FFFFFF" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!-- Capa de brillo diagonal (glass reflection) -->
            <Border CornerRadius="20"
                    IsHitTestVisible="False"
                    Opacity="0.04">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="White" Offset="0"/>
                        <GradientStop Color="Transparent" Offset="0.5"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <Grid x:Name="MainGrid">
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition x:Name="ContentRow" Height="*"/>
                </Grid.RowDefinitions>

                <!-- ══════════════════════════════════════
                     BARRA DE TÍTULO
                ══════════════════════════════════════ -->
                <Border x:Name="TitleBar"
                        Grid.Row="0"
                        CornerRadius="20,20,0,0"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#30FFFFFF" Offset="0"/>
                            <GradientStop Color="#06FFFFFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>

                    <Grid Margin="14,0,8,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Dot de acento con glow -->
                        <Ellipse x:Name="AccentDot"
                                 Grid.Column="0"
                                 Width="8" Height="8"
                                 VerticalAlignment="Center"
                                 Fill="{StaticResource AccentBrush}">
                            <Ellipse.Effect>
                                <DropShadowEffect x:Name="DotGlow"
                                                  Color="#A855F7"
                                                  BlurRadius="10"
                                                  ShadowDepth="0"
                                                  Opacity="1.0"/>
                            </Ellipse.Effect>
                        </Ellipse>

                        <!-- Título -->
                        <Grid Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock x:Name="TitleText"
                                       Text="Nuevo Fence"
                                       Foreground="#F0FFFFFF"
                                       FontWeight="SemiBold"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       MouseLeftButtonDown="TitleText_MouseLeftButtonDown"
                                       Cursor="Hand"
                                       ToolTip="Doble clic para renombrar"
                                       TextTrimming="CharacterEllipsis"/>

                            <TextBox x:Name="TitleEdit"
                                     Foreground="White"
                                     Background="Transparent"
                                     BorderThickness="0,0,0,1"
                                     BorderBrush="{StaticResource AccentBrush}"
                                     FontWeight="SemiBold"
                                     FontSize="12"
                                     CaretBrush="White"
                                     VerticalAlignment="Center"
                                     Visibility="Collapsed"
                                     LostFocus="TitleEdit_LostFocus"
                                     KeyDown="TitleEdit_KeyDown"/>
                        </Grid>

                        <!-- Botones -->
                        <StackPanel Grid.Column="3"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">

                            <Button x:Name="BtnLock"
                                    Style="{StaticResource TitleBarButtonStyle}"
                                    ToolTip="Bloquear movimiento"
                                    Click="BtnLock_Click">
                                <fa:IconBlock x:Name="LockIcon" Icon="LockOpen"
                                              Foreground="#70FFFFFF" Width="11" Height="11"/>
                            </Button>

                            <Button x:Name="BtnPin"
                                    Style="{StaticResource TitleBarButtonStyle}"
                                    ToolTip="Anclar expandido"
                                    Click="BtnPin_Click">
                                <fa:IconBlock x:Name="PinIcon" Icon="Thumbtack"
                                              Foreground="#70FFFFFF" Width="11" Height="11"/>
                            </Button>

                            <Button x:Name="BtnCollapse"
                                    Style="{StaticResource TitleBarButtonStyle}"
                                    ToolTip="Colapsar / Expandir"
                                    Click="BtnCollapse_Click">
                                <fa:IconBlock x:Name="CollapseIcon" Icon="Minus"
                                              Foreground="#70FFFFFF" Width="11" Height="11"/>
                            </Button>

                            <Button x:Name="BtnSettings"
                                    Style="{StaticResource TitleBarButtonStyle}"
                                    ToolTip="Configuración"
                                    Click="BtnSettings_Click">
                                <fa:IconBlock Icon="Cog"
                                              Foreground="#70FFFFFF" Width="11" Height="11"/>
                            </Button>

                            <Button x:Name="BtnDeletePanel"
                                    Style="{StaticResource TitleBarButtonStyle}"
                                    ToolTip="Eliminar panel"
                                    Click="BtnDeletePanel_Click">
                                <fa:IconBlock Icon="Trash"
                                              Foreground="#90FF6B6B" Width="11" Height="11"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Separador degradado bajo título -->
                <Rectangle Grid.Row="0"
                            Height="1"
                            VerticalAlignment="Bottom"
                            IsHitTestVisible="False">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#00FFFFFF" Offset="0"/>
                            <GradientStop Color="#25FFFFFF" Offset="0.5"/>
                            <GradientStop Color="#00FFFFFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <!-- ══════════════════════════════════════
                     ÁREA DE CONTENIDO
                ══════════════════════════════════════ -->
                <Border x:Name="ContentBorder"
                        Grid.Row="1"
                        Background="Transparent"
                        CornerRadius="0,0,20,20"
                        ClipToBounds="True"
                        AllowDrop="True"
                        PreviewDragOver="ContentBorder_PreviewDragOver"
                        DragLeave="ContentBorder_DragLeave"
                        Drop="ContentBorder_Drop">

                    <Grid>
                        <!-- Drop hint -->
                        <StackPanel x:Name="DropHint"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    IsHitTestVisible="False"
                                    Panel.ZIndex="1"
                                    Visibility="Visible">
                            <TextBlock Text="⬇"
                                       FontSize="22"
                                       HorizontalAlignment="Center"
                                       Foreground="#30FFFFFF"/>
                            <TextBlock Text="Arrastra accesos aquí"
                                       Foreground="#35FFFFFF"
                                       FontSize="10"
                                       FontWeight="Light"
                                       Margin="0,4,0,0"/>
                        </StackPanel>

                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      PanningMode="VerticalOnly"
                                      CanContentScroll="False">

                            <ItemsControl x:Name="ContentItems" Margin="6,6,6,8">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"
                                                   ItemWidth="72"
                                                   ItemHeight="96"
                                                   Margin="2"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="ShortcutBorder"
                                                Background="Transparent"
                                                BorderBrush="Transparent"
                                                BorderThickness="1"
                                                CornerRadius="14"
                                                Margin="0" Padding="0"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Top"
                                                Cursor="Hand"
                                                RenderTransformOrigin="0.5,0.5"
                                                MouseLeftButtonUp="ShortcutItem_Click"
                                                MouseMove="ShortcutBorder_MouseMove"
                                                MouseEnter="ShortcutBorder_MouseEnter"
                                                MouseLeave="ShortcutBorder_MouseLeave"
                                                ToolTip="{Binding Path}">

                                            <Border.RenderTransform>
                                                <ScaleTransform x:Name="ItemScale"
                                                                ScaleX="1" ScaleY="1"/>
                                            </Border.RenderTransform>


                                            <Grid x:Name="ShortcutGrid"
                                                  Width="68" Height="92"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Top">

                                                <!-- Botón eliminar -->
                                                <Button x:Name="BtnDeleteShortcut"
                                                        Width="16" Height="16"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Top"
                                                        Background="#CC6B2B2B"
                                                        Foreground="White"
                                                        BorderThickness="0"
                                                        FontSize="8" FontWeight="Bold"
                                                        Visibility="Collapsed"
                                                        Content="✕"
                                                        Click="BtnDeleteShortcut_Click"
                                                        Margin="0,-4,-4,0"
                                                        Panel.ZIndex="3"
                                                        Padding="0"/>

                                                <!-- Glow de hover bajo el ícono -->
                                                <Ellipse x:Name="IconGlow"
                                                         Width="52" Height="16"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Top"
                                                         Margin="0,44,0,0"
                                                         Opacity="0"
                                                         IsHitTestVisible="False"
                                                         Panel.ZIndex="0">
                                                    <Ellipse.Fill>
                                                        <RadialGradientBrush>
                                                            <GradientStop Color="#80A855F7" Offset="0"/>
                                                            <GradientStop Color="#00A855F7" Offset="1"/>
                                                        </RadialGradientBrush>
                                                    </Ellipse.Fill>
                                                </Ellipse>

                                                <!-- Contenedor del ícono -->
                                                <Border x:Name="IconContainer"
                                                        Width="52" Height="52"
                                                        CornerRadius="16"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Top"
                                                        Margin="0,2,0,0"
                                                        Panel.ZIndex="1">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                            <GradientStop Color="#40FFFFFF" Offset="0"/>
                                                            <GradientStop Color="#15FFFFFF" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                    <Border.Effect>
                                                        <DropShadowEffect Color="Black"
                                                                          BlurRadius="12"
                                                                          ShadowDepth="3"
                                                                          Opacity="0.4"/>
                                                    </Border.Effect>

                                                    <!-- Highlight de esquina en el ícono -->
                                                    <Grid>
                                                        <Image Source="{Binding Icon}"
                                                               Width="36" Height="36"
                                                               MaxWidth="200" MaxHeight="200"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Stretch="Uniform"
                                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                                        <!-- Brillo interno del contenedor -->
                                                        <Border CornerRadius="16"
                                                                IsHitTestVisible="False">
                                                            <Border.Background>
                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                    <GradientStop Color="#25FFFFFF" Offset="0"/>
                                                                    <GradientStop Color="#00FFFFFF" Offset="0.6"/>
                                                                </LinearGradientBrush>
                                                            </Border.Background>
                                                        </Border>
                                                    </Grid>
                                                </Border>

                                                <!-- Nombre -->
                                                <TextBlock Text="{Binding Name}"
                                                           Foreground="#C8FFFFFF"
                                                           FontSize="9"
                                                           TextWrapping="Wrap"
                                                           TextAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Bottom"
                                                           HorizontalAlignment="Center"
                                                           Margin="2,0,2,2"
                                                           LineHeight="11"
                                                           MaxHeight="24"
                                                           Width="66"
                                                           Panel.ZIndex="1"/>
                                            </Grid>

                                            <Border.ContextMenu>
                                                <ContextMenu Background="#F0101020"
                                                             BorderBrush="#30FFFFFF"
                                                             BorderThickness="1"
                                                             HasDropShadow="True">
                                                    <ContextMenu.Resources>
                                                        <Style TargetType="MenuItem">
                                                            <Setter Property="Foreground" Value="#E0FFFFFF"/>
                                                            <Setter Property="FontSize"   Value="12"/>
                                                        </Style>
                                                        <Style TargetType="Separator">
                                                            <Setter Property="Background" Value="#20FFFFFF"/>
                                                        </Style>
                                                    </ContextMenu.Resources>
                                                    <MenuItem Header="▶  Abrir"            Click="Ctx_Open_Click"/>
                                                    <MenuItem Header="📂  Abrir ubicación" Click="Ctx_OpenLocation_Click"/>
                                                    <Separator/>
                                                    <MenuItem Header="✏  Renombrar"        Click="Ctx_Rename_Click"/>
                                                    <MenuItem Header="🔄  Recargar ícono"  Click="Ctx_ReloadIcon_Click"/>
                                                    <Separator/>
                                                    <MenuItem Header="🗑  Eliminar"         Click="Ctx_Delete_Click"/>
                                                </ContextMenu>
                                            </Border.ContextMenu>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
