<Window x:Class="FencesWPF.Views.SearchDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Buscar acceso directo"
        Width="360" Height="400"
        WindowStyle="ToolWindow"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="#FF1A1A2E"
        Foreground="White"
        Loaded="Window_Loaded">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Search box -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="TbSearch" Grid.Column="0"
                     Padding="6,5" FontSize="13"
                     KeyUp="TbSearch_KeyUp"
                     ToolTip="Escribe para filtrar"/>
            <Button Grid.Column="1" Content="🔍" Width="32"
                    Margin="4,0,0,0" Click="BtnSearch_Click"/>
        </Grid>

        <!-- Results -->
        <ListBox x:Name="LbResults" Grid.Row="1"
                 Background="#FF0D0D20"
                 Foreground="White"
                 BorderBrush="#FF4A90D9"
                 SelectionChanged="LbResults_SelectionChanged"
                 MouseDoubleClick="LbResults_MouseDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="4,2">
                        <TextBlock Text="{Binding ShortcutName}"
                                   FontWeight="SemiBold" FontSize="12"/>
                        <TextBlock Text="{Binding FenceName}"
                                   Foreground="#FF70A0D0" FontSize="10"/>
                        <TextBlock Text="{Binding Path}"
                                   Foreground="#FF505070" FontSize="9"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Footer -->
        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="▶  Abrir" Width="80" Margin="0,0,8,0"
                    Click="BtnOpen_Click"/>
            <Button Content="Cerrar" Width="80"
                    Click="BtnClose_Click"/>
        </StackPanel>
    </Grid>
</Window>
