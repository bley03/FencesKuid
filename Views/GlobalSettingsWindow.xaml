<Window x:Class="FencesWPF.Views.GlobalSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AppFence — Configuración Global"
        Width="480" Height="680"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- ── Shared colours ── -->
        <SolidColorBrush x:Key="AccentBlue"    Color="#FF4A90D9"/>
        <SolidColorBrush x:Key="PanelBg"       Color="#FF1A1A2E"/>
        <SolidColorBrush x:Key="CardBg"        Color="#22FFFFFF"/>
        <SolidColorBrush x:Key="SubText"       Color="#FFB0B0C0"/>
        <SolidColorBrush x:Key="GoldText"      Color="#FFFFD060"/>
        <SolidColorBrush x:Key="DangerRed"     Color="#FFD94A4A"/>

        <!-- ── TitleBar drag helper ── -->
        <Style x:Key="DragHandle" TargetType="Border"/>

        <!-- ── Flat button ── -->
        <Style x:Key="FlatBtn" TargetType="Button">
            <Setter Property="Background"       Value="#FF1A4A8A"/>
            <Setter Property="Foreground"       Value="White"/>
            <Setter Property="BorderThickness"  Value="0"/>
            <Setter Property="Cursor"           Value="Hand"/>
            <Setter Property="Padding"          Value="12,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FF2A5AAA"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FF0F3070"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Danger button ── -->
        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource FlatBtn}">
            <Setter Property="Background" Value="#FF6B1A1A"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF8B2A2A"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ── Section label ── -->
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF7AB8FF"/>
            <Setter Property="FontSize"   Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin"     Value="0,0,0,4"/>
        </Style>

        <!-- ── TextBox dark ── -->
        <Style x:Key="DarkTextBox" TargetType="TextBox">
            <Setter Property="Background"       Value="#33FFFFFF"/>
            <Setter Property="Foreground"       Value="White"/>
            <Setter Property="BorderBrush"      Value="#FF3A3A5A"/>
            <Setter Property="BorderThickness"  Value="1"/>
            <Setter Property="Padding"          Value="6,4"/>
            <Setter Property="CaretBrush"       Value="White"/>
        </Style>

        <!-- ── Slider ── -->
        <Style x:Key="SlimSlider" TargetType="Slider">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- ── ComboBox ── -->
        <Style x:Key="DarkCombo" TargetType="ComboBox">
            <Setter Property="Background"      Value="#33FFFFFF"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="BorderBrush"     Value="#FF3A3A5A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="6,4"/>
        </Style>

        <!-- ── CheckBox ── -->
        <Style x:Key="WhiteCb" TargetType="CheckBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin"     Value="0,4"/>
            <Setter Property="Cursor"     Value="Hand"/>
        </Style>
    </Window.Resources>

    <!-- ═══════════════════ ROOT SHADOW BORDER ═══════════════════ -->
    <Border CornerRadius="14" Background="#FF1A1A2E">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="30" ShadowDepth="4" Opacity="0.6"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52"/>   <!-- custom title bar -->
                <RowDefinition Height="*"/>    <!-- scrollable content -->
                <RowDefinition Height="Auto"/> <!-- footer -->
            </Grid.RowDefinitions>

            <!-- ════ TITLE BAR ════ -->
            <Border Grid.Row="0" Background="#FF12122A" CornerRadius="14,14,0,0"
                    MouseLeftButtonDown="TitleBar_MouseDown">
                <Grid Margin="18,0,12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Icon + title -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="10" Height="10" Fill="#FF4A90D9" Margin="0,0,10,0"/>
                        <TextBlock Text="AppFence" Foreground="White"
                                   FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock Text="  —  Configuración Global" Foreground="#FF7090B0"
                                   FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Close button -->
                    <Button Grid.Column="2" Content="✕" Width="32" Height="32"
                            Background="Transparent" Foreground="#FF8080A0"
                            BorderThickness="0" FontSize="14"
                            Cursor="Hand" Click="BtnClose_Click"
                            VerticalAlignment="Center">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bd" Background="Transparent" CornerRadius="8">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#336B1A1A"/>
                                                    <Setter Property="Foreground" Value="#FFD94A4A"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="#FF8080A0"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="FontSize" Value="14"/>
                                <Setter Property="Cursor" Value="Hand"/>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>

            <!-- ════ SCROLLABLE CONTENT ════ -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          PanningMode="VerticalOnly">
                <StackPanel Margin="18,14,18,10">

                    <!-- ─── APARIENCIA GLOBAL ─────────────────────────────── -->
                    <TextBlock Text="APARIENCIA GLOBAL" Style="{StaticResource SectionLabel}"/>
                    <Border Background="{StaticResource CardBg}" CornerRadius="10" Padding="14,12" Margin="0,0,0,14">
                        <StackPanel>

                            <!-- Opacity slider -->
                            <TextBlock Text="Opacidad por defecto:" Foreground="{StaticResource SubText}" FontSize="11"/>
                            <Grid Margin="0,4,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="42"/>
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="SliderOpacity" Grid.Column="0"
                                        Minimum="0.1" Maximum="1" Value="0.92"
                                        TickFrequency="0.05" IsSnapToTickEnabled="True"
                                        VerticalAlignment="Center"
                                        ValueChanged="SliderOpacity_ValueChanged"/>
                                <TextBlock x:Name="TbOpacity" Grid.Column="1"
                                           Text="92%" Foreground="{StaticResource SubText}"
                                           VerticalAlignment="Center" FontSize="11" Margin="6,0,0,0"/>
                            </Grid>

                            <!-- Background colour -->
                            <TextBlock Text="Color de fondo (AARRGGBB):" Foreground="{StaticResource SubText}" FontSize="11"/>
                            <Grid Margin="0,4,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="36"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TbBgColor" Grid.Column="0" Text="#CC1E1E2E"
                                         Style="{StaticResource DarkTextBox}"
                                         TextChanged="TbBgColor_TextChanged"/>
                                <Border x:Name="BgPreview" Grid.Column="1" Margin="6,2,0,2"
                                        CornerRadius="6" Background="#CC1E1E2E"
                                        BorderBrush="#FF3A3A5A" BorderThickness="1"
                                        Cursor="Hand" ToolTip="Clic para abrir selector de color"
                                        MouseLeftButtonUp="BgPreview_Click"/>
                            </Grid>

                            <!-- Border colour -->
                            <TextBlock Text="Color del borde:" Foreground="{StaticResource SubText}" FontSize="11"/>
                            <Grid Margin="0,4,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="36"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TbBorderColor" Grid.Column="0" Text="#FF4A90D9"
                                         Style="{StaticResource DarkTextBox}"
                                         TextChanged="TbBorderColor_TextChanged"/>
                                <Border x:Name="BorderPreview" Grid.Column="1" Margin="6,2,0,2"
                                        CornerRadius="6" Background="#FF4A90D9"
                                        BorderBrush="#FF3A3A5A" BorderThickness="1"
                                        Cursor="Hand" ToolTip="Clic para abrir selector de color"
                                        MouseLeftButtonUp="BorderPreview_Click"/>
                            </Grid>

                            <!-- Title colour -->
                            <TextBlock Text="Color de barra de título:" Foreground="{StaticResource SubText}" FontSize="11"/>
                            <Grid Margin="0,4,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="36"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TbTitleColor" Grid.Column="0" Text="#FF2A2A4A"
                                         Style="{StaticResource DarkTextBox}"
                                         TextChanged="TbTitleColor_TextChanged"/>
                                <Border x:Name="TitlePreview" Grid.Column="1" Margin="6,2,0,2"
                                        CornerRadius="6" Background="#FF2A2A4A"
                                        BorderBrush="#FF3A3A5A" BorderThickness="1"
                                        Cursor="Hand" ToolTip="Clic para abrir selector de color"
                                        MouseLeftButtonUp="TitlePreview_Click"/>
                            </Grid>

                            <!-- Quick themes -->
                            <TextBlock Text="Temas rápidos:" Foreground="{StaticResource SubText}" FontSize="11" Margin="0,0,0,6"/>
                            <WrapPanel>
                                <Button Content="🌑 Oscuro"  Width="76" Margin="0,0,6,6" Style="{StaticResource FlatBtn}" Click="Theme_Dark"/>
                                <Button Content="🌊 Azul"    Width="76" Margin="0,0,6,6" Style="{StaticResource FlatBtn}" Click="Theme_Blue"/>
                                <Button Content="🌿 Verde"   Width="76" Margin="0,0,6,6" Style="{StaticResource FlatBtn}" Click="Theme_Green"/>
                                <Button Content="🌹 Rojo"    Width="76" Margin="0,0,6,6" Style="{StaticResource FlatBtn}" Click="Theme_Red"/>
                                <Button Content="🍇 Morado"  Width="76" Margin="0,0,6,6" Style="{StaticResource FlatBtn}" Click="Theme_Purple"/>
                                <Button Content="🌙 Noche"   Width="76" Margin="0,0,0,6" Style="{StaticResource FlatBtn}" Click="Theme_Night"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- ─── COMPORTAMIENTO Y VALORES POR DEFECTO ──────────── -->
                    <TextBlock Text="COMPORTAMIENTO Y VALORES POR DEFECTO" Style="{StaticResource SectionLabel}"/>
                    <Border Background="{StaticResource CardBg}" CornerRadius="10" Padding="14,12" Margin="0,0,0,14">
                        <StackPanel>

                            <!-- Mode -->
                            <TextBlock Text="Modo de nuevo fence:" Foreground="{StaticResource SubText}" FontSize="11"/>
                            <ComboBox x:Name="CbDefaultMode" Margin="0,4,0,10"
                                      Background="#33FFFFFF" Foreground="White"
                                      SelectionChanged="CbDefaultMode_SelectionChanged">
                                <ComboBoxItem Content="Estático — siempre expandido"/>
                                <ComboBoxItem Content="Auto-Roll — expande al pasar el ratón" IsSelected="True"/>
                                <ComboBoxItem Content="Colapsado"/>
                            </ComboBox>

                            <!-- Icon size -->
                            <TextBlock Text="Tamaño de iconos:" Foreground="{StaticResource SubText}" FontSize="11"/>
                            <ComboBox x:Name="CbDefaultIconSize" Margin="0,4,0,0"
                                      Background="#33FFFFFF" Foreground="White"
                                      SelectionChanged="CbDefaultIconSize_SelectionChanged">
                                <ComboBoxItem Content="Pequeño (32px)"/>
                                <ComboBoxItem Content="Mediano (48px)" IsSelected="True"/>
                                <ComboBoxItem Content="Grande (64px)"/>
                            </ComboBox>
                        </StackPanel>
                    </Border>

                    <!-- ─── APLICAR A PANELES ACTIVOS ─────────────────────── -->
                    <TextBlock Text="APLICAR A PANELES ACTIVOS" Style="{StaticResource SectionLabel}"/>
                    <Border Background="#1AFFD060" CornerRadius="10" Padding="14,12" Margin="0,0,0,14"
                            BorderBrush="#33FFD060" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Foreground="{StaticResource GoldText}" FontWeight="SemiBold" FontSize="12"
                                       Text="⚡  Propagación en tiempo real" Margin="0,0,0,4"/>
                            <TextBlock Foreground="{StaticResource SubText}" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,10"
                                       Text="Aplica la apariencia (fondo, borde, título, opacidad), el modo y el tamaño de iconos configurados arriba a todos los paneles que estén abiertos en este momento."/>
                            <Button x:Name="BtnApplyAll" Content="⚡  Aplicar a Todos los Paneles"
                                    HorizontalAlignment="Left" Style="{StaticResource FlatBtn}"
                                    Background="#FF7A5000"
                                    Click="BtnApplyAll_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- ─── SISTEMA ────────────────────────────────────────── -->
                    <TextBlock Text="SISTEMA" Style="{StaticResource SectionLabel}"/>
                    <Border Background="{StaticResource CardBg}" CornerRadius="10" Padding="14,12" Margin="0,0,0,14">
                        <StackPanel>
                            <CheckBox x:Name="CbStartWithWindows" Content="Iniciar con Windows"
                                      Style="{StaticResource WhiteCb}" Click="CbStartWithWindows_Click"/>
                            <CheckBox x:Name="CbAutoSave" Content="Guardado automático"
                                      Style="{StaticResource WhiteCb}" Click="CbAutoSave_Click"/>
                            <StackPanel Orientation="Horizontal" Margin="22,4,0,0">
                                <TextBlock Text="Intervalo (seg):" Foreground="{StaticResource SubText}"
                                           VerticalAlignment="Center" FontSize="11"/>
                                <TextBox x:Name="TbAutoSaveInterval" Text="30" Width="54"
                                         Margin="8,0,0,0" Style="{StaticResource DarkTextBox}"
                                         LostFocus="TbAutoSaveInterval_LostFocus"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ─── ALINEAMIENTO MAGNÉTICO ─────────────────────────── -->
                    <TextBlock Text="ALINEAMIENTO MAGNÉTICO" Style="{StaticResource SectionLabel}"/>
                    <Border Background="{StaticResource CardBg}" CornerRadius="10" Padding="14,12" Margin="0,0,0,14">
                        <StackPanel>
                            <CheckBox x:Name="CbEnableSnapping" Content="Activar snap entre fences"
                                      Style="{StaticResource WhiteCb}" Click="CbEnableSnapping_Click"/>
                            <StackPanel Orientation="Horizontal" Margin="22,6,0,0">
                                <TextBlock Text="Tolerancia:" Foreground="{StaticResource SubText}"
                                           VerticalAlignment="Center" FontSize="11"/>
                                <Grid Margin="8,0,0,0" Width="180">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="38"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider x:Name="SliderSnap" Grid.Column="0"
                                            Minimum="5" Maximum="50" Value="15"
                                            VerticalAlignment="Center"
                                            ValueChanged="SliderSnap_ValueChanged"/>
                                    <TextBlock x:Name="TbSnap" Grid.Column="1"
                                               Text="15px" Foreground="{StaticResource SubText}"
                                               VerticalAlignment="Center" FontSize="11" Margin="6,0,0,0"/>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ─── ALMACENAMIENTO ─────────────────────────────────── -->
                    <TextBlock Text="ALMACENAMIENTO" Style="{StaticResource SectionLabel}"/>
                    <Border Background="{StaticResource CardBg}" CornerRadius="10" Padding="14,12" Margin="0,0,0,6">
                        <StackPanel>
                            <TextBlock x:Name="TbStoragePath" Text="..." Foreground="#FF5090C0"
                                       FontSize="10" TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <Button Content="📂  Abrir carpeta de datos" HorizontalAlignment="Left"
                                    Style="{StaticResource FlatBtn}" Click="BtnOpenDataFolder_Click"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- ════ FOOTER ════ -->
            <Border Grid.Row="2" Background="#FF12122A" CornerRadius="0,0,14,14" Padding="18,12">
                <Grid>
                    <TextBlock Text="Los cambios de apariencia y comportamiento se aplican a nuevos fences. Usa ⚡ para los paneles actuales."
                               Foreground="#FF505070" FontSize="9.5" TextWrapping="Wrap"
                               VerticalAlignment="Center" Margin="0,0,145,0"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="Guardar y Cerrar" Width="130" Margin="0,0,8,0"
                                Style="{StaticResource FlatBtn}" Click="BtnSave_Click"/>
                        <Button Content="Cerrar" Width="72"
                                Background="#FF2A2A40" Foreground="#FFB0B0C0"
                                BorderThickness="0" Padding="8,7" Cursor="Hand"
                                Click="BtnClose_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bd" Background="#FF2A2A40" CornerRadius="8"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="#FF3A3A55"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="Background" Value="#FF2A2A40"/>
                                    <Setter Property="Foreground" Value="#FFB0B0C0"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Padding" Value="8,7"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

        </Grid>
    </Border>
</Window>
